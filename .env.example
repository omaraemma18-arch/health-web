# Example environment variables for SMTP/email
# Replace with your SMTP provider details
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Omara Health <no-reply@example.com>"
CONTACT_RECEIVER=clinic@example.com
PORT=3000
